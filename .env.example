# Copy this file to .env and fill in real values. .env is git-ignored — never commit real secrets.

SUPABASE_URL=https://onclzyjhfkgonemcpcmo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# StatsPlus league base path, no trailing slash
STATSPLUS_BASE_URL=https://atl-02.statsplus.net/thebigleague/api

# Preferred auth for /ratings/ and /gamehistory/ (2026-08-28): StatsPlus's own documented
# API token (wiki.statsplus.net/web-tools/statsplus-api), generated from the account
# Preferences page on the StatsPlus website. Valid ~90 days from creation, no browser/
# CAPTCHA/session needed — this is what scripts/refresh.ts uses when present, and what the
# automated GitHub Actions refresh relies on. Regenerate from Preferences when it expires.
STATSPLUS_API_TOKEN=

# Older fallback auth for /ratings/ or /gamehistory/ — only used if STATSPLUS_API_TOKEN is
# unset. Grab fresh values from your browser's DevTools (Application > Cookies) after
# logging into StatsPlus. These expire unpredictably; re-grab whenever a refresh needs them.
STATSPLUS_SESSION_ID=
STATSPLUS_CSRF_TOKEN=

# Owner/guest page-visibility gate (see HANDOFF.md §9). OWNER_PASSWORD is what's typed
# at /login; OWNER_COOKIE_SECRET is an opaque random string used to HMAC-sign the auth
# cookie. Required in production (Vercel dashboard env vars) -- without them, every
# request is treated as a guest, and /login can never succeed. Not required for local
# dev unless you're specifically testing the auth flow.
OWNER_PASSWORD=
OWNER_COOKIE_SECRET=
